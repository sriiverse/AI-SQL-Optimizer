GEMINI_API_KEY=

# Paid Gemini and Groq calls. Default is closed (unset or blank).
# A GEMINI_API_KEY or GROQ_API_KEY does not open those calls by itself.
# Set a long random secret here, then send Authorization: Bearer <secret>
# from a trusted client. Do not put this value in frontend code or in any
# VITE_ variable. The public website does not send it.
# PROVIDER_ACCESS_TOKEN=

# Shared query history. Default is off (unset, empty, or any value other than
# 1/true/yes/on). Do not enable this on a shared or public deployment.
# There is no authentication and no per-user isolation. Enabling it stores
# analyzed queries in one SQLite file and serves them from GET /history.
# The file is created only after this flag is on and a request uses history.
# HISTORY_ENABLED=false

# Local CLI agent WebSocket and /agent routes. Default is off.
# AGENT_ENABLED is only a feature switch, not authentication. Any caller can
# choose a client id while it is on. Leave it disabled on public deployments
# until access control exists. The CLI simulates a timer and does not execute SQL.
# AGENT_ENABLED=false

# Input and provider protections. Defaults apply when a value is unset.
# A malformed value stops the process instead of disabling the protection.
# MAX_QUERY_CHARS=20000
# MAX_SCHEMA_CHARS=100000
# MAX_QUESTION_CHARS=4000
# MAX_BODY_BYTES=262144
# ANALYSIS_TIMEOUT_SECONDS=30
# GENERATION_TIMEOUT_SECONDS=45
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_MAX_KEYS=10000
# The rate limit is per process, not shared across workers or instances.
# The client key is the direct connection address. X-Forwarded-For is ignored.

