# Local API origin for analysis, generation, and the health check.
# `npm run dev` uses http://localhost:8000 when this is unset.
# A production build does not. Set this in Netlify to the public Render
# origin, with no path and no trailing slash, for example
# https://your-service.onrender.com
# Do not put GEMINI_API_KEY, GROQ_API_KEY, or PROVIDER_ACCESS_TOKEN here.
VITE_API_BASE_URL=http://localhost:8000
